				"color": "grey",
				"labelColor": "black",
				"fill": "solid",
				"size": "s",
				"font": "mono",
				"align": "middle",
				"verticalAlign": "middle",
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Network security"
								},
								{
									"type": "text",
									"text": " is "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "highlight"
										},
										{
											"type": "bold"
										}
									],
									"text": "the set of rules, technologies, and practices designed to protect the integrity, confidentiality, and accessibility of a network and its data"
								},
								{
									"type": "text",
									"text": ". It acts as a digital shield that prevents unauthorized access, misuse, modification, or denial of service. Organizations implement these defenses using a combination of specialized hardware devices and software applications. By creating multiple layers of defense, it secures both the network perimeter and the data moving inside it. Ultimately, effective security ensures that legitimate users can work efficiently while malicious threats are blocked."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "anPxksF8",
			"typeName": "shape"
