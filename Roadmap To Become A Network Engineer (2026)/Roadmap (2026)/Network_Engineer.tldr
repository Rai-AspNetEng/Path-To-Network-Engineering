			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:K4Fk71jJUR3pjLfp2u55I",
			"type": "geo",
			"props": {
				"w": 887.9900512695312,
				"h": 295.93402099609375,
				"geo": "rectangle",
				"dash": "solid",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "grey",
				"labelColor": "black",
				"fill": "solid",
				"size": "s",
				"font": "mono",
				"align": "middle",
				"verticalAlign": "middle",
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Cloud networking"
								},
								{
									"type": "text",
									"text": " is "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "highlight"
										},
										{
											"type": "bold"
										}
									],
									"text": "an IT infrastructure strategy where network resources and capabilities are hosted on a public or private cloud platform and delivered on demand"
								},
								{
									"type": "text",
									"text": ". Instead of managing physical routers, switches, and cables in an on-premises data center, engineers configure virtualized network components using software over the internet. Leaders like "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "https://aws.amazon.com/what-is/cloud-networking/",
												"target": "_blank",
												"rel": "noopener",
												"class": "H23r4e"
											}
										},
										{
											"type": "bold"
										},
										{
											"type": "underline"
										}
									],
									"text": "AWS"
								},
								{
									"type": "text",
									"text": " explain that it shifts the ownership and maintenance of the underlying physical hardware entirely to the cloud vendor. Enterprises utilize this strategy to establish "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "https://www.cloudflare.com/learning/cloud/what-is-cloud-networking/",
												"target": "_blank",
												"rel": "noopener",
												"class": "H23r4e"
											}
										},
										{
											"type": "bold"
										},
										{
											"type": "underline"
										}
									],
									"text": "Virtual Private Clouds (VPCs)"
								},
								{
									"type": "text",
									"text": ", securely linking scattered on-premises data centers, remote users, and cloud applications together. It forms the essential connectivity fabric that lets modern "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "https://www.vmware.com/topics/cloud-networking",
												"target": "_blank",
												"rel": "noopener",
												"class": "H23r4e"
											}
										},
										{
											"type": "bold"
										},
										{
											"type": "underline"
										}
									],
									"text": "cloud computing"
								},
								{
									"type": "text",
									"text": " systems scale instantly and function globally."
								}
							]
						}
					]
				}
			},
