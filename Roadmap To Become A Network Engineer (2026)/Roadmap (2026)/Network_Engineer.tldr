									"type": "text",
									"text": ", "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "https://stackify.com/what-is-infrastructure-as-code-how-it-works-best-practices-tutorials/",
												"target": "_blank",
												"rel": "noopener noreferrer nofollow",
												"class": null
											}
