										},
										{
											"type": "bold"
										}
									],
									"text": "Infrastructure as Code (IaC) is the practice of managing and provisioning computing infrastructure through machine-readable definition files instead of physical hardware configuration or manual interactive tools."
								},
								{
									"type": "text",
									"text": " It allows you to write descriptive code to automatically spin up, configure, and tear down networks, servers, and storage. ["
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "https://en.wikipedia.org/wiki/Infrastructure_as_code",
												"target": "_blank",
												"rel": "noopener noreferrer nofollow",
												"class": null
											}
										}
									],
									"text": "1"
								},
