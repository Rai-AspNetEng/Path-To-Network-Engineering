				"fill": "solid",
				"size": "s",
				"font": "mono",
				"align": "middle",
				"verticalAlign": "middle",
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Packet analysis"
								},
								{
									"type": "text",
									"text": " is "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "highlight"
										},
										{
											"type": "bold"
										}
									],
									"text": "the process of intercepting, logging, and inspecting data packets as they travel across a network"
								},
								{
									"type": "text",
									"text": ". It acts like a digital magnifying glass that lets engineers look inside data payloads to diagnose performance bugs or find security threats. Network administrators use specialized software like "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "https://www.wireshark.org/",
												"target": "_blank",
												"rel": "noopener",
												"class": "H23r4e"
											}
										},
										{
											"type": "bold"
										},
										{
											"type": "underline"
										}
									],
									"text": "Wireshark"
								},
								{
									"type": "text",
									"text": " to capture this live traffic. By reading the protocol headers, they can pinpoint exactly why a connection is slow or where a cyberattack is originating. It is the ultimate tool for deep network troubleshooting and forensic security inspection."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "anPxgYGV",
			"typeName": "shape"
